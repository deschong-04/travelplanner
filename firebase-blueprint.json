{
  "entities": {
    "Trip": {
      "title": "Trip Info",
      "description": "Information about the planner's overview",
      "type": "object",
      "properties": {
        "plannerName": { "type": "string" },
        "destination": { "type": "string" },
        "arrivalDate": { "type": "string" },
        "departureDate": { "type": "string" },
        "updatedAt": { "type": "string" },
        "ownerId": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "baseCurrency": { "type": "string" },
        "targetCurrency": { "type": "string" },
        "conversionRate": { "type": "number" }
      },
      "required": ["plannerName", "destination", "arrivalDate", "departureDate"]
    },
    "Place": {
      "title": "Itinerary Stop",
      "description": "A scheduled or database place on the travel router",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "district": { "type": "string" },
        "category": { "type": "string" },
        "address": { "type": "string" },
        "day": { "type": "string" },
        "time": { "type": "string" },
        "expanded": { "type": "boolean" },
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      },
      "required": ["id", "name", "district", "category"]
    },
    "Presence": {
      "title": "Collaborator Presence",
      "description": "Active collaborator session info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "activeAt": { "type": "string" }
      },
      "required": ["id", "name", "activeAt"]
    }
  },
  "firestore": {
    "/trips/{tripId}": {
      "schema": "Trip",
      "description": "Stores trip metadata"
    },
    "/trips/{tripId}/places/{placeId}": {
      "schema": "Place",
      "description": "Stores places/stops for the collaborative trip"
    },
    "/trips/{tripId}/presence/{presenceId}": {
      "schema": "Presence",
      "description": "Active collaborators in this trip room"
    }
  }
}
