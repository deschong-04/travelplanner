rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // Validation for Trip Entity
    function isValidTrip(data) {
      return data.plannerName is string 
        && data.plannerName.size() <= 200
        && data.destination is string
        && data.destination.size() <= 200
        && data.arrivalDate is string 
        && data.arrivalDate.size() <= 50
        && data.departureDate is string 
        && data.departureDate.size() <= 50
        && (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128))
        && (!('lat' in data) || data.lat is number)
        && (!('lng' in data) || data.lng is number)
        && (!('baseCurrency' in data) || (data.baseCurrency is string && data.baseCurrency.size() <= 10))
        && (!('targetCurrency' in data) || (data.targetCurrency is string && data.targetCurrency.size() <= 10))
        && (!('conversionRate' in data) || data.conversionRate is number)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Validation for Place Entity
    function isValidPlace(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.name is string 
        && data.name.size() <= 300
        && data.district is string 
        && data.district.size() <= 100
        && data.category is string 
        && data.category.size() <= 100
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && (!('day' in data) || (data.day is string && data.day.size() <= 100))
        && (!('time' in data) || (data.time is string && data.time.size() <= 100))
        && (!('expanded' in data) || data.expanded is bool)
        && (!('lat' in data) || data.lat is number)
        && (!('lng' in data) || data.lng is number);
    }

    // Validation for Presence Entity
    function isValidPresence(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.name is string
        && data.name.size() <= 100
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1000))
        && data.activeAt is string
        && data.activeAt.size() <= 100;
    }

    // Rule for trips
    match /trips/{tripId} {
      allow get: if isValidId(tripId);
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.ownerId == 'sandbox_guest_explorer' || resource.data.ownerId == 'guest');
      allow create: if isValidId(tripId) && isValidTrip(incoming());
      allow update: if isValidId(tripId) && isValidTrip(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'plannerName', 
          'destination', 
          'arrivalDate', 
          'departureDate', 
          'updatedAt', 
          'ownerId', 
          'lat', 
          'lng', 
          'baseCurrency', 
          'targetCurrency', 
          'conversionRate'
        ])
      );
      allow delete: if isValidId(tripId);

      // Rule for subcollection places
      match /places/{placeId} {
        allow get: if isValidId(tripId) && isValidId(placeId);
        allow list: if isValidId(tripId);
        allow create: if isValidId(tripId) && isValidId(placeId) && isValidPlace(incoming());
        allow update: if isValidId(tripId) && isValidId(placeId) && isValidPlace(incoming());
        allow delete: if isValidId(tripId) && isValidId(placeId);
      }

      // Rule for subcollection presence
      match /presence/{presenceId} {
        allow get: if isValidId(tripId) && isValidId(presenceId);
        allow list: if isValidId(tripId);
        allow create: if isValidId(tripId) && isValidId(presenceId) && isValidPresence(incoming());
        allow update: if isValidId(tripId) && isValidId(presenceId) && isValidPresence(incoming());
        allow delete: if isValidId(tripId) && isValidId(presenceId);
      }
    }
  }
}
